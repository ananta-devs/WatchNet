# WatchNet Core Environment Variables

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=watchnet
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/watchnet
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/watchnet

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & Session
SECRET_KEY=replace-with-a-random-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Collector Daemon
COLLECTOR_INTERFACE=eth0
BACKEND_URL=http://localhost:8000
SCAN_INTERVAL_SEC=30

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
