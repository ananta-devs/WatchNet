# ==============================================================================
# WatchNet — Root .gitignore
# Multi-stack monorepo: Python (FastAPI), Go (Collector), Node.js (Next.js 14+)
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets (Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# Python (backend)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
test-results/
playwright-report/
playwright-report.json

# Type Checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js & Next.js (frontend)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js Build Outputs
.next/
out/

# Next.js telemetry & cache
.turbo/
.vercel/

# TypeScript declaration cache
*.tsbuildinfo
next-env.d.ts.bak

# ------------------------------------------------------------------------------
# Go (collector)
# ------------------------------------------------------------------------------
# Binaries (target compiled executables, not source directories)
/bin/
*.exe
*.exe~
*.dll
*.dylib
/collector/watchnet-collector
/watchnet-collector

# Test artifacts
*.test
test_buffer.json
collector_buffer.db*

# ------------------------------------------------------------------------------
# Databases, Buffers & Docker Volumes
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.log
postgres_data/
redis_data/
caddy_data/
caddy_config/

# ------------------------------------------------------------------------------
# Operating System & IDEs
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors & IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
